---
const services = [
  { t: "طراحی و محاسبات", d: "نقشه معماری و محاسبات سازه، متناسب با زمین، نیاز و بودجه شما." },
  { t: "تولید سازه LSF", d: "تولید مقاطع فولادی گالوانیزه مطابق نقشه، آماده مونتاژ." },
  { t: "ساخت ویلا و خانه", d: "اجرای صفر تا صد؛ از تحویل زمین تا تحویل کلید." },
  { t: "اضافه‌اشکوب و روف‌گاردن", d: "طبقه سبک روی ساختمان موجود، بدون تخریب سقف." },
  { t: "نوسازی و بازسازی", d: "به‌روزرسانی ساختمان‌های قدیمی با روش‌های مدرن." },
  { t: "اجرای نما", d: "مدرن مینیمال، شیروانی، مراکشی، کلاسیک یا سبک دلخواه شما." },
];
---
<section id="services" class="block">
  <div class="wrap">
    <div class="head">
      <h2>خدمات</h2>
      <p class="muted measure">تخصص ما ساخت، نوسازی و بازسازیه. کیفیت، دقت و تحویل به‌موقع، در هر مرحله.</p>
    </div>
    <ul class="svc">
      {services.map((s) => <li><h3>{s.t}</h3><p class="muted">{s.d}</p></li>)}
    </ul>
  </div>
</section>

<style>
  .svc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 2.5rem; }
  .svc li { padding: 1.3rem 0 1.5rem; border-top: 1.5px solid #b6bbb5; }
  .svc h3 { margin-bottom: .35rem; }
  .svc p { margin: 0; font-size: .95rem; }
  @media (max-width: 880px) { .svc { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .svc { grid-template-columns: 1fr; } }
</style>
