---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Festival from "../components/Festival.astro";
import WhyLsf from "../components/WhyLsf.astro";
import Addition from "../components/Addition.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Styles from "../components/Styles.astro";
import Projects from "../components/Projects.astro";
import Faq from "../components/Faq.astro";
import Estimate from "../components/Estimate.astro";
import Footer from "../components/Footer.astro";
---
<Base
  title="دیار سازه | ساخت ویلا و خانه با سازه LSF در مازندران"
  description="دیار سازه، پیمانکار رسمی ساختمان در ساری؛ طراحی، تولید و اجرای سازه سبک فولادی LSF، ساخت ویلا، اضافه‌اشکوب، نوسازی و بازسازی. از زمین تا کلید."
>
  <Header />
  <main id="main">
    <Hero />
    <div class="rail rail--dark" aria-hidden="true"></div>
    <Festival />
    <WhyLsf />
    <Addition />
    <Services />
    <Process />
    <Styles />
    <Projects />
    <Faq />
    <Estimate />
  </main>
  <Footer />
</Base>
